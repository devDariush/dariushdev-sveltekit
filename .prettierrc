{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": [
				"CONTRIBUTING.md",
				"README.md",
				"docs/ARCHITECTURE.md",
				"docs/CLOUDFLARE_DEPLOYMENT.md",
				"docs/TEST_COVERAGE.md"
			],
			"options": {
				"useTabs": false
			}
		}
	],
	"tailwindStylesheet": "./src/routes/layout.css"
}
